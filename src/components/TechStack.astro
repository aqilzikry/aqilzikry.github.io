---
import SectionHeader from "./SectionHeader.astro";
import { techGroups } from "@content/portfolio";
---

<section class="section-shell" id="stack">
  <SectionHeader
    eyebrow="Stack"
    title="What I work with."
    copy="Grouped by layer. Deepest in .NET, C#, and SQL Server, with Angular and React on the front end."
  />

  <div class="stack-grid">
    {
      techGroups.map((group) => (
        <article class="stack-card">
          <h3>{group.label}</h3>
          <div class="tag-row">
            {group.items.map((item) => <span>{item}</span>)}
          </div>
        </article>
      ))
    }
  </div>
</section>
