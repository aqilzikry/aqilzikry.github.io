---
import Icon from "./Icon.astro";
import { tools } from "@content/portfolio";

const toolRefs: Record<string, string> = {
  "Color converter": "color",
  "JSON/XML validator": "validator",
  "JWT decoder": "jwt",
  "Base64 encoder": "base64",
  "URL encoder": "url",
  "Timezone converter": "timezone",
  "Budget calculator": "budget",
  "Deadline countdown": "deadline",
};
---

<section class="section-shell tools-section" id="tools" aria-labelledby="tools-title">
  <div class="tools-panel">
    <div class="tools-panel-copy">
      <p class="eyebrow">Tools</p>
      <h2 id="tools-title">{tools.length} dev tools that run in your browser.</h2>
      <p>Encoders, validators, converters, and calculators I built for daily use. Nothing is uploaded.</p>
    </div>
    <div class="tools-panel-actions">
      <div class="tool-list" aria-label="Available tools">
        {tools.map((tool) => <a href={`/tools/#${toolRefs[tool]}`}>{tool}</a>)}
      </div>
      <a class="button button-primary" href="/tools/">
        Open the tools
        <Icon name="arrow" />
      </a>
    </div>
  </div>
</section>
